# Конфигурация развёртывания Share Server
# Скопируйте: sudo cp scripts/deploy.env.example /etc/share-server/deploy.env
# и отредактируйте перед запуском deploy.sh

# Репозиторий и ветка
GITHUB_REPO=https://github.com/sergey-frolov-pets/share_server.git
GIT_BRANCH=main

# Пути и сервис
APP_DIR=/opt/share-server
APP_USER=share
APP_GROUP=share
SERVICE_NAME=share-server

# Node.js (major version)
NODE_MAJOR=20

# Публичный адрес сайта (для .env BASE_URL и nginx)
DOMAIN=share.example.com
BASE_URL=https://share.example.com

# Порт приложения (внутренний, nginx проксирует)
APP_PORT=3000

# Админ (смените после установки!)
LOGIN_USERNAME=admin
LOGIN_PASSWORD=changeme

# Лимит размера одного файла, МБ
MAX_FILE_SIZE_MB=4096

# Размер части при загрузке, МБ (nginx client_max_body_size должен быть >= этому значению)
CHUNK_SIZE_MB=5

# Nginx: макс. размер одного запроса (части файла)
NGINX_CLIENT_MAX_BODY=10m

# Установить nginx и настроить reverse proxy
INSTALL_NGINX=true

# Открыть ufw: 22, 80, 443
CONFIGURE_UFW=true
